amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"

local linters = new Mapping<String, Step> {
  ["format"] {
    glob = List("*.rs")
    exclusive = true
    fix = "mise run format"
  }
  ["lint"] {
    glob = List("*.rs")
    exclusive = true
    check = "mise run lint"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
